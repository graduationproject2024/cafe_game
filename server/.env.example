# ==============================================================================
# the A&A Specialty Cafe & Sweets — Al-Madinah Al-Munawwarah
# Phase 2 Secure Backend Environment Configuration Template
# ==============================================================================

# Server Network Port
PORT=3000

# Environment Mode: development | test | production
NODE_ENV=production

# Cryptographic Server Signing Secret
# MANDATORY IN PRODUCTION: Must be at least 32 characters long.
# Used for HMAC-SHA256 voucher signing, session tokens, and cryptographic certificates.
AA_SERVER_SECRET=REPLACE_WITH_SECURE_RANDOM_32_CHARACTERS_SECRET_KEY_HERE

# Database File Path (For SQLite) or Connection URI (For PostgreSQL/Supabase)
AA_DB_PATH=./src/db/aa_cafe.db

# Optional Initial Production Administrator Bootstrap
# If staff_accounts table is empty on first startup, the server provisions this single account.
AA_BOOTSTRAP_ADMIN_USER=admin_madinah
AA_BOOTSTRAP_ADMIN_PASS=REPLACE_WITH_STRONG_ADMIN_PASSWORD_MIN_12_CHARS

# Allowed Frontend Origins for CORS (comma-separated, or * for development)
ALLOWED_ORIGINS=https://cafe.aa-specialty.com,https://staff.aa-specialty.com

